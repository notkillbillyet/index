<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>台北酒店整理 ver.2</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#efefef;
    --ink:#2b2a26;
    --ink-soft:#5c594f;
    --line:#c9c4b4;
    --tag-bg:#dedad0;
    --accent:#7a3b2e;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:"Noto Serif TC","Songti TC","PMingLiU",serif;
    line-height:1.75;
  }
  .wrap{
    max-width:640px;
    margin:0 auto;
    padding:56px 20px 100px;
  }
  header{
    margin-bottom:40px;
    border-bottom:1px solid var(--line);
    padding-bottom:24px;
  }
  header .eyebrow{
    font-family:"Noto Sans Mono","Courier New",monospace;
    font-size:12px;
    letter-spacing:0.15em;
    color:var(--ink-soft);
    text-transform:uppercase;
  }
  header h1{
    font-size:24px;
    font-weight:600;
    margin:10px 0 8px;
  }
  .back-link{
    display:inline-block;
    margin-bottom:32px;
    font-size:13px;
    color:var(--ink-soft);
    text-decoration:none;
    font-family:"Noto Sans Mono","Courier New",monospace;
  }
  .back-link:hover{
    color:var(--accent);
  }
  ul.venues{
    list-style:none;
    margin:0;
    padding:0;
  }
  ul.venues li{
    border-bottom:1px dashed var(--line);
    padding:14px 0;
  }
  ul.venues li:last-child{
    border-bottom:none;
  }
  .venue-name{
    font-size:16px;
    font-weight:600;
  }
  .venue-tags{
    margin-top:4px;
  }
  .tag{
    display:inline-block;
    font-family:"Noto Sans Mono","Courier New",monospace;
    font-size:10.5px;
    background:var(--tag-bg);
    color:var(--ink-soft);
    padding:2px 7px;
    border-radius:3px;
    margin-right:6px;
    margin-top:4px;
    letter-spacing:0.02em;
  }
  footer{
    margin-top:60px;
    padding-top:20px;
    border-top:1px solid var(--line);
    font-size:12px;
    color:var(--ink-soft);
    font-family:"Noto Sans Mono","Courier New",monospace;
  }
</style>
</head>
<body>
<div class="wrap">

  <a class="back-link" href="index.html">← 回索引</a>

